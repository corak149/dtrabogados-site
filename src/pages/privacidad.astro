    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
  }
  ol, ul {
    padding-left: 1.5rem;
  }
  ol li, ul li {
    margin-bottom: 0.6rem;
  }
  .text-muted {
    color: var(--texto-claro);
  }
</style>
