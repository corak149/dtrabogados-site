---
/**
 * Hub por área (10 páginas generadas estáticamente).
 * Ruta: /derecho-migratorio/, /derecho-civil/, etc.
 */
import Layout from "../../layouts/Layout.astro";
import { AREAS } from "../../data/areas";
import { waLink } from "../../utils/whatsapp";

export function getStaticPaths() {
  return AREAS.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const wa = waLink({ tema: area.titulo });
---

<Layout
  title={`${area.titulo} — DTR Abogados`}
  description={area.descripcion}
>
  <section class="section-tight section-navy">
    <div class="container-content">
      <nav class="crumbs" aria-label="breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/areas-de-practica/">Áreas</a>
      </nav>
      <span class="kicker" style="color: var(--dtr-gold-light);">Área de práctica</span>
      <h1 style="color: var(--dtr-white);">{area.titulo}</h1>
      <p style="color: rgba(255,255,255,0.85); font-size: 1.1rem;">
        {area.pregunta}
      </p>
    </div>
  </section>

  {area.head && (
    <section class="section-tight section-cream">
      <div class="container">
        <div class="head-card">
          <div class="head-photo">
            <img
              src={area.head.foto}
              alt={area.head.foto_alt}
              width="800"
              height="450"
              loading="eager"
            />
          </div>
          <div class="head-info">
            <div class="head-role">{area.head.cargo}</div>
            <h2 class="head-name">{area.head.nombre}</h2>
            <p class="head-specialty">{area.head.especialidad}</p>
            <p class="head-bio">{area.head.bio}</p>
            {area.head.stats && (
              <div class="head-stats">
                {area.head.stats.expedientes && (
                  <div class="stat">
                    <div class="stat-value">{area.head.stats.expedientes}</div>
                    <div class="stat-label">Expedientes tramitados</div>
                  </div>
                )}
                {area.head.stats.success_rate && (
                  <div class="stat">
                    <div class="stat-value">{area.head.stats.success_rate}</div>
                    <div class="stat-label">Tasa de éxito</div>
                  </div>
                )}
                {area.head.stats.otras?.map((s) => (
                  <div class="stat">
                    <div class="stat-value">{s.value}</div>
                    <div class="stat-label">{s.label}</div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <p class="lede-area">{area.descripcion}</p>

      {area.grupos.map((grupo) => (
        <div class="grupo">
          <h2 class="grupo-title">
            <a href={`/${area.slug}/${grupo.slug}/`}>
              {grupo.titulo}
            </a>
          </h2>
          {grupo.procesos.length > 0 && (
            <ul class="proceso-list">
              {grupo.procesos.map((p) => (
                <li>
                  <a href={`/${area.slug}/${grupo.slug}/${p.slug}/`}>
                    {p.titulo}
                    <span class="proc-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {grupo.procesos.length === 0 && (
            <p class="grupo-empty">
              Contactanos para consultar por este servicio.
            </p>
          )}
        </div>
      ))}

      <div class="cta-block">
        <h3>¿Tenés un caso específico en {area.tituloCorto}?</h3>
        <p>Cuéntenos su caso — le respondemos en menos de 24 horas hábiles.</p>
        <div class="cta-row">
          <a href={wa} class="cta cta-whatsapp" target="_blank" rel="noopener">
            WhatsApp
          </a>
          <a href="/contacto/" class="cta cta-outline">Formulario</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .crumbs a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }
  .lede-area {
    font-size: 1.15rem;
    color: var(--texto-claro);
    margin-bottom: 3rem;
    line-height: 1.6;
  }
  .grupo {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--dtr-line);
  }
  .grupo:last-of-type {
    border-bottom: 0;
  }
  .grupo-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .grupo-title a {
    color: var(--dtr-navy);
    text-decoration: none;
  }
  .grupo-title a:hover {
    color: var(--dtr-gold-dark);
  }
  .proceso-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .proceso-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .proceso-list li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    background: var(--dtr-white);
    border: 1px solid var(--dtr-line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--texto);
    font-weight: 500;
    transition: all var(--transition);
  }
  .proceso-list li a:hover {
    border-color: var(--dtr-gold);
    color: var(--dtr-navy);
    transform: translateX(3px);
  }
  .proc-arrow {
    color: var(--dtr-gold);
  }
  .grupo-empty {
    color: var(--texto-claro);
    font-style: italic;
    font-size: 0.95rem;
  }
  .cta-block {
    margin-top: 3rem;
    padding: 2.5rem;
    background: var(--dtr-cream-alt);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .cta-block h3 {
    margin-bottom: 0.5rem;
  }
  .cta-block p {
    color: var(--texto-claro);
    margin-bottom: 1.5rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  /* === Head Card === */
  .head-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    background: var(--dtr-white);
    border: 1px solid var(--dtr-line);
    border-radius: var(--radius-lg);
    padding: 2rem;
    align-items: center;
  }
  @media (min-width: 720px) {
    .head-card {
      grid-template-columns: 340px 1fr;
      gap: 2.5rem;
      padding: 2.25rem 2.5rem;
    }
  }
  @media (min-width: 1080px) {
    .head-card {
      grid-template-columns: 400px 1fr;
    }
  }
  .head-photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--dtr-cream-alt);
  }
  .head-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .head-role {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--dtr-gold-dark);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .head-name {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    color: var(--dtr-navy);
    margin: 0 0 0.35rem 0;
    line-height: 1.2;
  }
  .head-specialty {
    color: var(--dtr-navy);
    font-weight: 500;
    margin: 0 0 1rem 0;
    font-size: 1rem;
  }
  .head-bio {
    color: var(--texto-claro);
    line-height: 1.65;
    margin: 0 0 1.5rem 0;
    font-size: 0.98rem;
  }
  .head-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--dtr-line);
  }
  .stat {
    text-align: left;
  }
  .stat-value {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--dtr-gold-dark);
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--texto-claro);
    line-height: 1.35;
  }
</style>
