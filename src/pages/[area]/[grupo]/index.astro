---
/**
 * Hub por grupo dentro de un área (~30 páginas generadas).
 * Ruta: /derecho-migratorio/visas/, /derecho-civil/propiedad-horizontal/, etc.
 */
import Layout from "../../../layouts/Layout.astro";
import { AREAS } from "../../../data/areas";
import { waLink } from "../../../utils/whatsapp";

export function getStaticPaths() {
  return AREAS.flatMap((area) =>
    area.grupos.map((grupo) => ({
      params: { area: area.slug, grupo: grupo.slug },
      props: { area, grupo },
    }))
  );
}

const { area, grupo } = Astro.props;
const wa = waLink({ tema: `${grupo.titulo} (${area.tituloCorto})` });
---

<Layout
  title={`${grupo.titulo} — ${area.titulo} — DTR Abogados`}
  description={`${grupo.titulo} en ${area.titulo}. Procesos, requisitos y honorarios.`}
>
  <section class="section-tight section-navy">
    <div class="container-content">
      <nav class="crumbs" aria-label="breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={`/${area.slug}/`}>{area.tituloCorto}</a>
      </nav>
      <span class="kicker" style="color: var(--dtr-gold-light);">
        {area.titulo}
      </span>
      <h1 style="color: var(--dtr-white);">{grupo.titulo}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container-content">
      {grupo.procesos.length > 0 ? (
        <>
          <p class="lede-grupo">
            Elegí el proceso que necesitás para ver los requisitos completos.
          </p>
          <ul class="proceso-list">
            {grupo.procesos.map((p) => (
              <li>
                <a href={`/${area.slug}/${grupo.slug}/${p.slug}/`}>
                  <strong>{p.titulo}</strong>
                  <span class="proc-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="empty-state">
          <p>
            Este servicio se atiende directamente por consulta. Contactanos
            para que evaluemos tu caso.
          </p>
          <a href={wa} class="cta cta-whatsapp" target="_blank" rel="noopener">
            Consultar por WhatsApp
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .crumbs a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }
  .lede-grupo {
    color: var(--texto-claro);
    margin-bottom: 2rem;
  }
  .proceso-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .proceso-list li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem;
    background: var(--dtr-white);
    border: 1px solid var(--dtr-line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--texto);
    transition: all var(--transition);
  }
  .proceso-list li a:hover {
    border-color: var(--dtr-gold);
    transform: translateX(3px);
    box-shadow: var(--shadow-sm);
  }
  .proceso-list li a strong {
    color: var(--dtr-navy);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .proc-arrow {
    color: var(--dtr-gold);
    font-size: 1.1rem;
  }
  .empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--dtr-cream-alt);
    border-radius: var(--radius-lg);
  }
  .empty-state p {
    color: var(--texto-claro);
    margin-bottom: 1.5rem;
  }
</style>
