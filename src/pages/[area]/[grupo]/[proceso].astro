---
/**
 * Plantilla de proceso (~50 páginas generadas).
 * Ruta: /derecho-migratorio/visas/visa-profesional/, etc.
 * Decisión V3 #10: cada proceso = URL propia con requisitos completos
 * separados por rol (persona natural vs empresa).
 *
 * TODO: Copy real por proceso pendiente. Sprint 1 substituye placeholders
 * con datos de:
 *   - 900-DANNA/02-En-Proceso/web-dtrabogados-v2/00-WEB-DTR-V3-iterativa.md
 *   - 800-Knowledge-PA/810-Migracion/... para requisitos técnicos
 */
import Layout from "../../../layouts/Layout.astro";
import { AREAS } from "../../../data/areas";

export function getStaticPaths() {
  return AREAS.flatMap((area) =>
    area.grupos.flatMap((grupo) =>
      grupo.procesos.map((proceso) => ({
        params: {
          area: area.slug,
          grupo: grupo.slug,
          proceso: proceso.slug,
        },
        props: { area, grupo, proceso },
      }))
    )
  );
}

const { area, grupo, proceso } = Astro.props;
const WHATSAPP = import.meta.env.PUBLIC_WHATSAPP || "50700000000";
const waLink = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(
  `Hola DTR — quisiera una consulta sobre ${proceso.titulo}.`
)}`;
---

<Layout
  title={`${proceso.titulo} — ${area.titulo} — DTR Abogados`}
  description={`${proceso.titulo} en Panamá. Requisitos, documentos y honorarios. Consulta inicial sin costo.`}
>
  <section class="section-tight section-navy">
    <div class="container container-narrow">
      <nav class="crumbs" aria-label="breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={`/${area.slug}/`}>{area.tituloCorto}</a>
        <span aria-hidden="true">/</span>
        <a href={`/${area.slug}/${grupo.slug}/`}>{grupo.titulo}</a>
      </nav>
      <span class="kicker" style="color: var(--dtr-gold-light);">
        {grupo.titulo}
      </span>
      <h1 style="color: var(--dtr-white);">{proceso.titulo}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <div class="todo-block">
        <p>
          <strong>Contenido en preparación.</strong> Estamos completando los
          requisitos, documentos y plazos para <em>{proceso.titulo}</em>.
          Mientras tanto, escribinos por WhatsApp y te contamos tu caso
          concreto en menos de 24 horas.
        </p>
        <a href={waLink} class="cta cta-whatsapp" target="_blank" rel="noopener">
          Consultar {proceso.titulo}
        </a>
      </div>

      <!-- Estructura base para copy V3 de Danna -->
      <div class="proc-section">
        <h2>Qué es</h2>
        <p class="placeholder">
          Descripción breve del proceso <em>{proceso.titulo}</em>.
          <span class="todo">TODO: copy V3 pendiente de Danna</span>
        </p>
      </div>

      <div class="proc-section proc-columns">
        <div>
          <h2>Requisitos para persona natural</h2>
          <ul class="placeholder-list">
            <li>Requisito 1 — <span class="todo">TODO</span></li>
            <li>Requisito 2 — <span class="todo">TODO</span></li>
            <li>Requisito 3 — <span class="todo">TODO</span></li>
          </ul>
        </div>
        <div>
          <h2>Requisitos para empresa</h2>
          <ul class="placeholder-list">
            <li>Requisito 1 — <span class="todo">TODO</span></li>
            <li>Requisito 2 — <span class="todo">TODO</span></li>
            <li>Requisito 3 — <span class="todo">TODO</span></li>
          </ul>
        </div>
      </div>

      <div class="proc-section">
        <h2>Documentos que necesitás</h2>
        <ul class="placeholder-list">
          <li>Pasaporte vigente (extranjeros)</li>
          <li>Cédula (nacionales)</li>
          <li class="todo">Otros documentos — TODO por proceso</li>
        </ul>
      </div>

      <div class="proc-section">
        <h2>Plazos estimados</h2>
        <p class="placeholder">
          <span class="todo">TODO: plazos varían por caso.</span> Te confirmamos
          los tiempos exactos en la consulta inicial.
        </p>
      </div>

      <div class="proc-section">
        <h2>Honorarios</h2>
        <p>
          Los honorarios se calculan según el <a href="/honorarios/">
          Acuerdo CNA 609-A/2021</a> del Colegio Nacional de Abogados. Te
          enviamos propuesta por escrito antes de arrancar.
        </p>
      </div>

      <div class="cta-block">
        <h3>Consulta inicial sin costo</h3>
        <p>
          Contanos tu caso — te decimos qué necesitás, cuánto tarda y cuánto
          cuesta. Sin compromiso.
        </p>
        <div class="cta-row">
          <a href={waLink} class="cta cta-whatsapp" target="_blank" rel="noopener">
            WhatsApp
          </a>
          <a href="/contacto/" class="cta cta-outline">Formulario</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .crumbs a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }

  .todo-block {
    padding: 1.5rem;
    background: var(--dtr-cream-alt);
    border-left: 4px solid var(--dtr-gold);
    border-radius: var(--radius);
    margin-bottom: 3rem;
  }
  .todo-block p {
    margin-bottom: 1rem;
  }

  .proc-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--dtr-line);
  }
  .proc-section:last-of-type {
    border-bottom: 0;
  }
  .proc-section h2 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
  }
  .proc-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 720px) {
    .proc-columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  .placeholder {
    color: var(--texto-claro);
  }
  .placeholder-list {
    padding-left: 1.25rem;
    color: var(--texto-claro);
  }
  .placeholder-list li {
    margin-bottom: 0.5rem;
  }
  .todo {
    display: inline-block;
    font-size: 0.75rem;
    background: rgba(184, 149, 74, 0.15);
    color: var(--dtr-gold-dark);
    padding: 0.1rem 0.5rem;
    border-radius: 3px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 600;
  }

  .cta-block {
    margin-top: 3rem;
    padding: 2.5rem;
    background: var(--dtr-cream-alt);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .cta-block h3 {
    margin-bottom: 0.5rem;
  }
  .cta-block p {
    color: var(--texto-claro);
    margin-bottom: 1.5rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
