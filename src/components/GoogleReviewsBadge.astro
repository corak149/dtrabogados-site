---
/**
 * Decisión V3 #7: Google Reviews con link directo en hero
 * + widget flotante. Link real pendiente (Greg configura Google
 * Business Profile). Por ahora: placeholder con TODO.
 */
const REVIEWS_URL =
  import.meta.env.PUBLIC_GOOGLE_REVIEWS_URL || "#google-reviews-todo";
---

<a
  href={REVIEWS_URL}
  class="reviews-badge"
  target="_blank"
  rel="noopener"
  aria-label="Ver reseñas en Google"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    aria-hidden="true"
    class="reviews-icon"
  >
    <path
      d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
      fill="currentColor"
    />
  </svg>
  <span class="reviews-text">
    <strong>Reseñas en Google</strong>
    <span class="reviews-sub">Leer opiniones de clientes</span>
  </span>
</a>

<style>
  .reviews-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.9rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--dtr-line);
    border-radius: 999px;
    text-decoration: none;
    color: var(--texto);
    font-size: 0.85rem;
    transition: all var(--transition);
  }
  .reviews-badge:hover {
    background: var(--dtr-white);
    border-color: var(--dtr-gold);
    box-shadow: var(--shadow-sm);
    color: var(--texto);
    text-decoration: none;
  }
  .reviews-icon {
    color: #f4b400;
    flex-shrink: 0;
  }
  .reviews-text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .reviews-text strong {
    color: var(--dtr-navy);
    font-weight: 600;
  }
  .reviews-sub {
    font-size: 0.72rem;
    color: var(--texto-claro);
  }
</style>
