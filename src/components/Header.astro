---
import Logo from "./Logo.astro";
import MegaMenu from "./MegaMenu.astro";
import { waLink } from "../utils/whatsapp";

const APP_URL = import.meta.env.PUBLIC_APP_URL || "https://argumento.app";
---

<header class="site-header">
  <div class="container header-inner">
    <Logo variant="full" />

    <nav aria-label="Principal">
      <ul class="nav-list">
        <li><MegaMenu /></li>
        <li><a href="/honorarios/">Honorarios</a></li>
        <li><a href="/quienes-somos/">Quiénes somos</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </nav>

    <div class="header-ctas">
      <a
        href={APP_URL}
        class="cta cta-outline cta-header"
        target="_blank"
        rel="noopener"
        aria-label="Acceso a clientes — abre Argumento en pestaña nueva"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 15v-2a3 3 0 013-3h1a3 3 0 013 3v2M9 21H5a2 2 0 01-2-2V7a2 2 0 012-2h4M12 3v12m0 0l-3-3m3 3l3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Acceso clientes
      </a>
      <a
        href={waLink()}
        class="cta cta-gold cta-header"
        target="_blank"
        rel="noopener"
      >
        WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--dtr-white);
    border-bottom: 1px solid var(--dtr-line);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(150%) blur(6px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }
  .nav-list {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.25rem;
    align-items: center;
  }
  .nav-list li a {
    color: var(--texto);
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition);
  }
  .nav-list li a:hover {
    color: var(--dtr-gold-dark);
  }

  .header-ctas {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cta-header {
    padding: 0.5rem 1rem;
    font-size: 0.88rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cta-header svg {
    flex-shrink: 0;
  }

  /* En mobile: solo WhatsApp, ocultar "Acceso clientes" (queda en el menú si hace falta) */
  @media (max-width: 720px) {
    .header-ctas .cta-outline {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .nav-list {
      display: flex;
    }
  }
</style>
