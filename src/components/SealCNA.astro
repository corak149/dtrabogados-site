---
/**
 * Sello decorativo circular referenciando el Acuerdo CNA 609-A.
 * Se usa como acompañante visual en la sección honorarios.
 */
---

<svg
  class="seal-cna"
  viewBox="0 0 200 200"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <path id="seal-arc-top" d="M 100 100 m -75 0 a 75 75 0 1 1 150 0" fill="none" />
    <path id="seal-arc-bottom" d="M 25 100 a 75 75 0 1 0 150 0" fill="none" />
  </defs>

  <!-- Círculos concéntricos -->
  <circle cx="100" cy="100" r="92" fill="none" stroke="#e6c98a" stroke-width="1" opacity="0.5"/>
  <circle cx="100" cy="100" r="82" fill="none" stroke="#e6c98a" stroke-width="1.5"/>
  <circle cx="100" cy="100" r="60" fill="none" stroke="#e6c98a" stroke-width="0.6" opacity="0.5"/>

  <!-- Texto arco superior -->
  <text font-family="'Source Sans 3', sans-serif" font-size="11" font-weight="600" fill="#e6c98a" letter-spacing="2.5">
    <textPath href="#seal-arc-top" startOffset="50%" text-anchor="middle">
      COLEGIO NACIONAL DE ABOGADOS · PANAMÁ
    </textPath>
  </text>

  <!-- Texto arco inferior -->
  <text font-family="'Source Sans 3', sans-serif" font-size="10" font-weight="500" fill="#e6c98a" letter-spacing="4">
    <textPath href="#seal-arc-bottom" startOffset="50%" text-anchor="middle">
      ACUERDO 609-A / 2021
    </textPath>
  </text>

  <!-- Balanza central -->
  <g transform="translate(100, 100)" stroke="#e6c98a" fill="none" stroke-linecap="round">
    <line x1="0" y1="-20" x2="0" y2="24" stroke-width="1.5"/>
    <circle cx="0" cy="-20" r="1.5" fill="#e6c98a"/>
    <line x1="-16" y1="-14" x2="16" y2="-14" stroke-width="1"/>
    <line x1="-16" y1="-14" x2="-18" y2="-2" stroke-width="0.5"/>
    <line x1="-16" y1="-14" x2="-14" y2="-2" stroke-width="0.5"/>
    <line x1="16" y1="-14" x2="18" y2="-2" stroke-width="0.5"/>
    <line x1="16" y1="-14" x2="14" y2="-2" stroke-width="0.5"/>
    <ellipse cx="-16" cy="-1" rx="7" ry="1.5" fill="#e6c98a"/>
    <ellipse cx="16" cy="-1" rx="7" ry="1.5" fill="#e6c98a"/>
    <ellipse cx="0" cy="28" rx="11" ry="2" fill="#e6c98a"/>
  </g>

  <!-- Marca superior e inferior -->
  <text x="100" y="52" text-anchor="middle" font-family="Georgia, serif" font-size="8" fill="#e6c98a" letter-spacing="3">TARIFA</text>
  <text x="100" y="158" text-anchor="middle" font-family="Georgia, serif" font-size="8" fill="#e6c98a" letter-spacing="3">MÍNIMA</text>
</svg>

<style>
  .seal-cna {
    width: 100%;
    height: auto;
    max-width: 180px;
    opacity: 0.9;
  }
</style>
