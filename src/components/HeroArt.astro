---
/**
 * Ilustración decorativa del hero — columnas + balanza estilizada
 * en dorado con línea fina. Solo desktop (oculta en <900px).
 */
---

<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="hero-gold" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#e6c98a" stop-opacity="0.9"/>
        <stop offset="60%" stop-color="#b8954a" stop-opacity="0.75"/>
        <stop offset="100%" stop-color="#8a6d33" stop-opacity="0.6"/>
      </linearGradient>
    </defs>

    <!-- Columnas romanas -->
    <g stroke="url(#hero-gold)" fill="none" stroke-linecap="round">
      <!-- Columna izquierda -->
      <g transform="translate(80, 100)">
        <rect x="-4" y="0" width="8" height="12" fill="url(#hero-gold)" stroke="none"/>
        <line x1="0" y1="12" x2="0" y2="290" stroke-width="6"/>
        <!-- Ranuras verticales -->
        <line x1="-2" y1="20" x2="-2" y2="285" stroke-width="0.5" opacity="0.4"/>
        <line x1="2" y1="20" x2="2" y2="285" stroke-width="0.5" opacity="0.4"/>
        <rect x="-6" y="290" width="12" height="12" fill="url(#hero-gold)" stroke="none"/>
      </g>

      <!-- Columna derecha -->
      <g transform="translate(320, 100)">
        <rect x="-4" y="0" width="8" height="12" fill="url(#hero-gold)" stroke="none"/>
        <line x1="0" y1="12" x2="0" y2="290" stroke-width="6"/>
        <line x1="-2" y1="20" x2="-2" y2="285" stroke-width="0.5" opacity="0.4"/>
        <line x1="2" y1="20" x2="2" y2="285" stroke-width="0.5" opacity="0.4"/>
        <rect x="-6" y="290" width="12" height="12" fill="url(#hero-gold)" stroke="none"/>
      </g>

      <!-- Arco superior -->
      <path d="M 80,100 Q 200,40 320,100" stroke-width="2" fill="none"/>
      <path d="M 80,100 Q 200,70 320,100" stroke-width="0.5" opacity="0.4" fill="none"/>
    </g>

    <!-- Balanza en el centro -->
    <g transform="translate(200, 220)" stroke="url(#hero-gold)" fill="none" stroke-linecap="round">
      <!-- Poste vertical -->
      <line x1="0" y1="-40" x2="0" y2="80" stroke-width="3"/>
      <circle cx="0" cy="-40" r="3" fill="url(#hero-gold)"/>
      <!-- Brazo -->
      <line x1="-58" y1="-28" x2="58" y2="-28" stroke-width="2.5"/>
      <!-- Cuerdas -->
      <line x1="-58" y1="-28" x2="-64" y2="10" stroke-width="1"/>
      <line x1="-58" y1="-28" x2="-40" y2="10" stroke-width="1"/>
      <line x1="58" y1="-28" x2="64" y2="10" stroke-width="1"/>
      <line x1="58" y1="-28" x2="40" y2="10" stroke-width="1"/>
      <!-- Platos -->
      <ellipse cx="-52" cy="12" rx="20" ry="4" fill="url(#hero-gold)"/>
      <path d="M-72,12 Q-52,32 -32,12" fill="url(#hero-gold)"/>
      <ellipse cx="52" cy="12" rx="20" ry="4" fill="url(#hero-gold)"/>
      <path d="M32,12 Q52,32 72,12" fill="url(#hero-gold)"/>
      <!-- Base -->
      <ellipse cx="0" cy="88" rx="32" ry="6" fill="url(#hero-gold)"/>
      <ellipse cx="0" cy="80" rx="10" ry="3" fill="url(#hero-gold)"/>
    </g>

    <!-- Marca decorativa inferior -->
    <line x1="140" y1="440" x2="260" y2="440" stroke="url(#hero-gold)" stroke-width="0.5"/>
  </svg>
</div>

<style>
  .hero-art {
    position: absolute;
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
    width: 320px;
    height: 400px;
    opacity: 0.85;
    pointer-events: none;
    z-index: 0;
  }
  .hero-art svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1024px) {
    .hero-art {
      display: none;
    }
  }
</style>
