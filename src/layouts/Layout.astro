---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-PA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DTR Abogados — Asesoría legal en Panamá: migración, propiedad horizontal, sociedades y civil. Honorarios transparentes según Acuerdo CSJ 609-A/2021." />
    <meta name="theme-color" content="#0a4d3a" />
    <meta property="og:title" content="DTR Abogados — Panamá" />
    <meta property="og:description" content="Asesoría legal en Panamá, sin sorpresas ni tecnicismos. Migración, PH, sociedades y civil." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fafaf7;
    --color-ink: #1a1a1a;
    --color-muted: #5b5b5b;
    --color-line: #e3e1da;
    --color-accent: #0a4d3a;
    --color-accent-hover: #083d2e;
    --font-serif: 'Georgia', 'Times New Roman', serif;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --max-width: 720px;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--color-bg);
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 0.5em 0;
  }

  p { margin: 0 0 1em 0; }

  a { color: var(--color-accent); }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4rem;
  }

  /* Top nav */
  .topnav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.85rem;
  }
  .topnav .brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .topnav nav a {
    color: var(--color-muted);
    text-decoration: none;
    margin-left: 1.25rem;
  }
  .topnav nav a:hover { color: var(--color-ink); }

  /* Hero */
  .hero { margin-bottom: 4rem; }
  .kicker {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    margin-bottom: 1.25rem;
  }
  .lede {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  /* CTAs */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border-radius: 4px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .cta-primary {
    background: var(--color-accent);
    color: #fff;
  }
  .cta-primary:hover { background: var(--color-accent-hover); }
  .cta-secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-line);
  }
  .cta-secondary:hover { border-color: var(--color-ink); }

  /* Secciones */
  section { margin-bottom: 3.5rem; }
  section h2 {
    font-size: 1.5rem;
    border-top: 1px solid var(--color-line);
    padding-top: 2rem;
  }

  /* Cards */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .cards { grid-template-columns: 1fr 1fr; }
  }
  .card {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 1.5rem;
    background: #fff;
  }
  .card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .card p {
    color: var(--color-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  /* Footer */
  .footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .footer p { margin: 0 0 0.5rem; }
  .footer .disclaimer {
    font-size: 0.75rem;
    color: #8b8b8b;
    margin-top: 0.75rem;
  }

  .id-line {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
  }
  .id-line strong { color: var(--color-ink); }
</style>
