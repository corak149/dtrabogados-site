---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = "DTR Abogados — Asesoría legal en Panamá: migración, propiedad horizontal, sociedades y civil. Honorarios transparentes según Acuerdo CNA 609-A/2021.",
  ogImage = "/logo-dtr.svg",
  canonical,
  noindex = false,
} = Astro.props;

const site = Astro.site?.toString() ?? "https://dtrabogados.com";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const fullTitle = title.includes("DTR") ? title : `${title} — DTR Abogados`;
---

<!doctype html>
<html lang="es-PA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#232a5e" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DTR Abogados" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, site).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org — LegalService -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LegalService",
        name: "DTR Abogados, Consultores y Asociados",
        url: site,
        description,
        areaServed: {
          "@type": "Country",
          name: "Panamá",
        },
        priceRange: "$$",
        knowsLanguage: ["es-PA"],
        serviceType: [
          "Derecho Migratorio",
          "Derecho Civil",
          "Derecho Comercial",
          "Propiedad Horizontal",
          "Derecho Laboral",
        ],
      })}
    />

    <title>{fullTitle}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Ir al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
